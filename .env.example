# Copy to .env locally. Never put secrets in source code or in chat.
GEMINI_API_KEY=
# Selected Gemini Developer API model; free-tier eligibility and quotas apply.
GEMINI_MODEL=gemini-3.1-flash-lite
# Deadline per request; retries wait 5s, then 10s with the defaults below.
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_BASE_SECONDS=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Created locally by python authorize_google.py (or supply client ID/secret above).
GOOGLE_CLIENT_FILE=credentials/client_secret.json
GOOGLE_TOKEN_FILE=credentials/token.json
# For Actions: paste the entire token.json into a secret with this name.
GOOGLE_TOKEN_JSON=
# Read-only Drive and Forms access. Set false for Classroom-only permissions.
READ_ATTACHMENTS=true
TEACHER_MODE=false
DAILY_SUMMARY=false
NOTIFY_POSSIBLE=true
MIN_CONFIDENCE=50
LOOKAHEAD_DAYS=180
DATABASE_PATH=data/classroom.sqlite3
# github is selected by the workflow; use local for a local test.
STATE_BACKEND=local
STATE_BRANCH=classroom-monitor-state
LOG_FILE=
